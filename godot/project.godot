; Engine configuration file.
;
; All values are kept as strings so they can be hand-edited or scripted.

config_version=5

[application]

config/name="Homebrewer"
config/description="A homebrew brewing simulation game."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/version="0.2.0"
config/version_code=0

[autoload]

Palette="*res://systems/palette.gd"
Lighting="*res://systems/lighting.gd"
Changelog="*res://systems/changelog.gd"
Version="*res://systems/version.gd"
Updater="*res://systems/updater.gd"
TimeService="*res://systems/time_service.gd"
GameState="*res://systems/game_state.gd"
SaveService="*res://systems/save_service.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/firebase_messaging/plugin.cfg")

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
